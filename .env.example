DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_MEDIA_ROOT=/app/media
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_TRUST_X_FORWARDED_PROTO=0
POSTGRES_DB=report
POSTGRES_USER=report
POSTGRES_PASSWORD=report
POSTGRES_HOST=db
POSTGRES_PORT=5432
MAX_UPLOAD_SIZE_MB=10
## Временный legacy fallback для проектов без собственного подключения.
TOPVISOR_USER_ID=
TOPVISOR_API_KEY=
TOPVISOR_API_BASE_URL=https://api.topvisor.com/v2/json
TOPVISOR_REQUEST_TIMEOUT_SECONDS=15
TOPVISOR_MAX_RETRIES=3
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=
# Стабильный Fernet-ключ: потеря сделает сохранённые API-ключи и OAuth-токены нечитаемыми.
CREDENTIAL_ENCRYPTION_KEY=
YANDEX_OAUTH_AUTHORIZE_URL=https://oauth.yandex.ru/authorize
YANDEX_OAUTH_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_METRIKA_API_BASE_URL=https://api-metrika.yandex.net
YANDEX_WEBMASTER_API_BASE_URL=https://api.webmaster.yandex.net/v4
YANDEX_REQUEST_TIMEOUT_SECONDS=15
YANDEX_MAX_RETRIES=3
